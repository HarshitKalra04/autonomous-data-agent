# Copy this file to .env and fill in your own key. Never commit .env.
LLM_API_KEY=your-api-key-here

# Leave LLM_BASE_URL empty for OpenAI. Examples for other providers:
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq   : https://api.groq.com/openai/v1
#   Ollama : http://localhost:11434/v1
LLM_BASE_URL=

# OpenAI: gpt-4o-mini | Gemini: gemini-3.1-flash-lite | Groq: llama-3.3-70b-versatile
LLM_MODEL=gpt-4o-mini

# Seconds to wait between LLM calls (helps with free-tier per-minute limits)
STEP_DELAY=4
